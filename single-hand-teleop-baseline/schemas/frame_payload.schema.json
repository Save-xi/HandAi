{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://save-xi.github.io/HandAi/schemas/frame_payload.schema.json",
  "title": "Single Hand Baseline Frame Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "frame_index",
    "detected",
    "handedness",
    "confidence",
    "control_ready",
    "gesture_raw",
    "gesture_stable",
    "pinch_distance_norm",
    "hand_open_ratio",
    "finger_curl",
    "landmarks_2d",
    "landmarks_3d",
    "control_representation",
    "svh_preview",
    "fps",
    "latency_ms"
  ],
  "deprecatedAliases": {
    "gesture": "gesture_stable",
    "svh": "svh_preview"
  },
  "properties": {
    "timestamp": {
      "type": "number"
    },
    "frame_index": {
      "type": "integer",
      "minimum": 0
    },
    "detected": {
      "type": "boolean"
    },
    "handedness": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "control_ready": {
      "type": "boolean",
      "description": "Top-level mirror of control_representation.command_ready for downstream consumers."
    },
    "gesture_raw": {
      "type": "string"
    },
    "gesture_stable": {
      "type": "string"
    },
    "pinch_distance_norm": {
      "type": [
        "number",
        "null"
      ]
    },
    "hand_open_ratio": {
      "type": [
        "number",
        "null"
      ]
    },
    "finger_curl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thumb",
        "index",
        "middle",
        "ring",
        "little"
      ],
      "properties": {
        "thumb": { "type": ["number", "null"] },
        "index": { "type": ["number", "null"] },
        "middle": { "type": ["number", "null"] },
        "ring": { "type": ["number", "null"] },
        "little": { "type": ["number", "null"] }
      }
    },
    "landmarks_2d": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number" }
      }
    },
    "landmarks_3d": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "number" }
      }
    },
    "control_representation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional extension object. It is always emitted in the frozen payload, but may be invalid when the extension is disabled or the frame is not command-ready.",
      "required": [
        "valid",
        "features_valid",
        "command_ready",
        "source",
        "gesture_context",
        "preferred_mapping",
        "grasp_close",
        "thumb_index_proximity",
        "effective_pinch_strength",
        "pinch_strength",
        "support_flex",
        "finger_flex"
      ],
      "properties": {
        "valid": {
          "type": "boolean",
          "description": "Compatibility mirror of command_ready."
        },
        "features_valid": {
          "type": "boolean",
          "description": "True when the continuous perception features needed for control are present this frame."
        },
        "command_ready": {
          "type": "boolean",
          "description": "Preferred downstream readiness flag for Unity / socket / preview consumers."
        },
        "source": { "type": ["string", "null"] },
        "gesture_context": { "type": ["string", "null"] },
        "preferred_mapping": {
          "type": ["string", "null"],
          "description": "Current control family selection. Valid values: grasp, pinch, or null."
        },
        "grasp_close": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0, "description": "Normalized grasp closure in [0, 1]." },
        "thumb_index_proximity": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0, "description": "Normalized thumb-index proximity cue in [0, 1]." },
        "effective_pinch_strength": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0, "description": "Gesture-aware pinch strength in [0, 1]. This is the preferred downstream pinch field." },
        "pinch_strength": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0, "description": "Deprecated compatibility mirror of effective_pinch_strength." },
        "support_flex": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0, "description": "Normalized support-finger flexion in [0, 1]." },
        "finger_flex": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-finger normalized flexion cues in [0, 1].",
          "required": [
            "thumb",
            "index",
            "middle",
            "ring",
            "little"
          ],
          "properties": {
            "thumb": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "index": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "middle": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "ring": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
            "little": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
          }
        }
      }
    },
    "svh_preview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional preview-only downstream object. It stays mock/skeleton oriented and must not be treated as a real hardware command without additional safety layers.",
      "required": [
        "enabled",
        "mode",
        "valid",
        "command_source",
        "target_channels",
        "target_positions",
        "target_ticks_preview",
        "protocol_hint"
      ],
      "properties": {
        "enabled": { "type": "boolean", "description": "Extension toggle. False means the baseline emitted a disabled placeholder preview object." },
        "mode": { "type": "string" },
        "valid": { "type": "boolean", "description": "True only when target arrays contain a usable preview command." },
        "command_source": { "type": ["string", "null"], "description": "Expected values when valid=true: control_representation or gesture_fallback." },
        "target_channels": {
          "type": "array",
          "description": "Preview channel indices for downstream consumers.",
          "items": { "type": "integer" }
        },
        "target_positions": {
          "type": "array",
          "description": "Normalized preview command magnitudes in [0, 1]. These are the preferred direct-consumption values for Unity/socket preview integrations.",
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "target_ticks_preview": {
          "type": "array",
          "description": "Preview-only encoder-like ticks. Do not treat these as hardware-safe final command units.",
          "items": { "type": "integer" }
        },
        "protocol_hint": {
          "type": "object",
          "additionalProperties": false,
          "description": "Metadata describing the preview layout, units, and protocol assumptions for downstream integration code.",
          "required": [
                    "transport",
            "channel_layout",
            "channel_order",
            "position_units",
            "target_tick_units"
          ],
          "properties": {
            "set_control_state_addr": { "type": "string" },
            "set_all_channels_addr": { "type": "string" },
            "transport": { "type": "string" },
            "channel_layout": { "type": "string" },
            "channel_order": { "type": "string" },
            "position_units": { "type": "string" },
            "target_tick_units": { "type": "string" }
          }
        }
      }
    },
    "fps": {
      "type": "number"
    },
    "latency_ms": {
      "type": "number"
    },
    "prediction_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional default-off shadow prediction diagnostics aligned to the top-level frame. This object is added only after the unchanged Unity UDP payload has been sent.",
      "required": [
        "schema_version",
        "mode",
        "enabled",
        "status",
        "ready",
        "source_frame_index",
        "source_timestamp_unix_ms",
        "history_frames_required",
        "history_frames_available",
        "history_span_ms",
        "observed_fps",
        "horizon_ms",
        "channel_order",
        "hold_last",
        "raw_prediction",
        "gated_prediction",
        "motion_score",
        "base_gate",
        "effective_gate_by_horizon",
        "inference_started_unix_ms",
        "inference_completed_unix_ms",
        "inference_ms",
        "gating_completed_unix_ms",
        "gating_ms",
        "raw_range_violation_count",
        "device",
        "model_label",
        "fallback_reason"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "mode": { "const": "shadow" },
        "enabled": { "const": true },
        "status": {
          "enum": [
            "initialization_error",
            "invalid_input",
            "warming_up",
            "predicted",
            "inference_error"
          ]
        },
        "ready": { "type": "boolean" },
        "source_frame_index": { "type": "integer", "minimum": 0 },
        "source_timestamp_unix_ms": { "type": "number", "minimum": 0.0 },
        "history_frames_required": { "type": "integer", "minimum": 2 },
        "history_frames_available": { "type": "integer", "minimum": 0 },
        "history_span_ms": { "type": ["number", "null"], "minimum": 0.0 },
        "observed_fps": { "type": ["number", "null"], "minimum": 0.0 },
        "horizon_ms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "channel_order": {
          "const": [
            "thumb_flexion",
            "thumb_opposition",
            "index_finger_distal",
            "index_finger_proximal",
            "middle_finger_distal",
            "middle_finger_proximal",
            "ring_finger",
            "pinky",
            "finger_spread"
          ]
        },
        "hold_last": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "raw_prediction": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "gated_prediction": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        },
        "motion_score": { "type": ["number", "null"], "minimum": 0.0 },
        "base_gate": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
        "effective_gate_by_horizon": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "inference_started_unix_ms": { "type": ["number", "null"], "minimum": 0.0 },
        "inference_completed_unix_ms": { "type": ["number", "null"], "minimum": 0.0 },
        "inference_ms": { "type": ["number", "null"], "minimum": 0.0 },
        "gating_completed_unix_ms": { "type": ["number", "null"], "minimum": 0.0 },
        "gating_ms": { "type": ["number", "null"], "minimum": 0.0 },
        "raw_range_violation_count": { "type": "integer", "minimum": 0 },
        "device": { "type": ["string", "null"] },
        "model_label": { "type": ["string", "null"] },
        "selection_sha256": {
          "type": ["string", "null"]
        },
        "checkpoint_sha256": {
          "type": ["string", "null"]
        },
        "fallback_reason": { "type": ["string", "null"] }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional phase timing diagnostics. Unix epoch milliseconds are directly comparable only when producer and consumer clocks are synchronized.",
      "required": [
        "schema_version",
        "clock",
        "source_read_start_unix_ms",
        "source_read_end_unix_ms",
        "detection_end_unix_ms",
        "baseline_end_unix_ms",
        "preview_end_unix_ms",
        "payload_ready_unix_ms",
        "udp_send_attempt_unix_ms"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "clock": { "const": "unix_epoch_ms" },
        "source_read_start_unix_ms": { "type": "number", "minimum": 0.0 },
        "source_read_end_unix_ms": { "type": "number", "minimum": 0.0 },
        "detection_end_unix_ms": { "type": "number", "minimum": 0.0 },
        "baseline_end_unix_ms": { "type": "number", "minimum": 0.0 },
        "preview_end_unix_ms": { "type": "number", "minimum": 0.0 },
        "payload_ready_unix_ms": { "type": "number", "minimum": 0.0 },
        "udp_send_attempt_unix_ms": {
          "type": ["number", "null"],
          "minimum": 0.0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "detected": { "const": true }
        }
      },
      "then": {
        "properties": {
          "handedness": { "const": "Right" },
          "confidence": { "type": "number" },
          "landmarks_2d": {
            "minItems": 21,
            "maxItems": 21
          },
          "landmarks_3d": {
            "minItems": 21,
            "maxItems": 21
          }
        }
      },
      "else": {
        "properties": {
          "handedness": { "type": "null" },
          "confidence": { "type": "null" },
          "control_ready": { "const": false },
          "landmarks_2d": { "maxItems": 0 },
          "landmarks_3d": { "maxItems": 0 },
          "svh_preview": {
            "properties": {
              "valid": { "const": false }
            }
          }
        }
      }
    }
  ]
}
